{
  "name": "pagmamahal",
  "version": "0.1.0",
  "private": true,
  "description": "Map of Pag-IBIG acquired properties for auction, with a housing loan calculator.",
  "license": "MIT",
  "author": "Pagmamahal Maps (https://github.com/lordgrim336-pixel/pagmamahal)",
  "homepage": "https://pagmamahal-maps.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/lordgrim336-pixel/pagmamahal.git"
  },
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "fetch": "node --max-old-space-size=6000 scripts/fetch-listings.mjs",
    "update-overture": "node scripts/update-overture.mjs",
    "update-boundaries": "node scripts/update-boundaries.mjs",
    "eval-locations": "node --max-old-space-size=6000 scripts/eval-locations.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.3.2-alpha.25",
    "@resvg/resvg-js": "^2.6.2"
  }
}
